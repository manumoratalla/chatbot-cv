# Copia este archivo como ".env" y rellena los valores allí (nunca aquí en env.example).

# Clave de la API de OpenAI.
OPENAI_API_KEY=

# Upstash Redis para los límites de uso. Opcional en local (sin ellas, los
# contadores van en memoria); obligatorio en Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clave secreta para seudonimizar las IPs antes de guardarlas en Upstash
# Se puede generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SECRET=
